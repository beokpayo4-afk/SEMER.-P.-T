DATABASE_URL=
# Pytest uses this database when it is set, then rolls each test back. Empty uses DATABASE_URL.
TEST_DATABASE_URL=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_ALGORITHM=HS256

APP_NAME=SEMER API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,https://semer.vercel.app

# Payment provider credentials. Leave empty until a provider is connected.
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=INR
PAYMENT_WEBHOOK_SECRET=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# Image files. local writes under backend/uploads. s3 is the same interface, not connected yet.
IMAGE_STORAGE=local
IMAGE_UPLOAD_DIR=
IMAGE_MAX_BYTES=5242880
IMAGE_S3_BUCKET=
IMAGE_S3_ENDPOINT=
IMAGE_S3_REGION=
IMAGE_S3_ACCESS_KEY=
IMAGE_S3_SECRET_KEY=
IMAGE_S3_PUBLIC_BASE_URL=
